# Telegram Appeal Bot - systemd unit
# Author: https://github.com/Leproide
# License: GPL-3.0
#
# Layout:
#   /opt/telegram-appeal-bot          code + venv (owned by root, read-only for the bot)
#   /opt/telegram-appeal-bot/.env     configuration (root:appealbot, mode 640)
#   /var/lib/telegram-appeal-bot      database (created by systemd, owned by appealbot)
#
# Install:
#   cp telegram-appeal-bot.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now telegram-appeal-bot
# Logs:
#   journalctl -u telegram-appeal-bot -f

[Unit]
Description=Telegram Appeal Bot (unban appeals)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appealbot
Group=appealbot
# Creates /var/lib/telegram-appeal-bot owned by appealbot; the database
# (DB_PATH=appeals.db, relative) is stored there
StateDirectory=telegram-appeal-bot
StateDirectoryMode=0750
WorkingDirectory=/var/lib/telegram-appeal-bot
ExecStart=/opt/telegram-appeal-bot/venv/bin/python /opt/telegram-appeal-bot/bot.py
Environment=TZ=Europe/Rome
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
