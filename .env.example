# Telegram Appeal Bot - configurazione
# Author: https://github.com/Leproide
# License: GPL-3.0
#
# Copia questo file in ".env" (col punto) nella stessa cartella di bot.py.
# Il file .env contiene il token: non va mai pubblicato (è già in .gitignore).

# Token del bot, ottenuto da @BotFather
BOT_TOKEN=

# ID del gruppo amministratori, dove arrivano gli appelli (es. -1001234567890).
# Se vuoto il bot parte in "modalità setup" e risponde solo a /chatid@NomeBot
ADMIN_CHAT_ID=

# ID del gruppo principale, da cui gli utenti sono stati bannati.
# Necessario solo con AUTO_UNBAN=true
MAIN_CHAT_ID=

# true = all'approvazione il bot rimuove il ban nel gruppo principale
# (il bot deve essere amministratore con permesso "Ban utenti")
AUTO_UNBAN=false

# Link del gruppo principale inviato all'utente quando l'appello è approvato (facoltativo)
# es. https://t.me/nomegruppo oppure un link d'invito privato
INVITE_LINK=

# true  = solo admin/owner del gruppo admin possono approvare/negare/bloccare
# false = qualunque membro del gruppo admin
REQUIRE_CHAT_ADMIN=false

# Percorso del database SQLite (relativo alla cartella di avvio o assoluto)
DB_PATH=appeals.db
