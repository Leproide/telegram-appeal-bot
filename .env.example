# Telegram Appeal Bot - configuration
# Author: https://github.com/Leproide
# License: GPL-3.0
#
# Copy this file to ".env" (with the dot) in the same folder as bot.py.
# The .env file contains the token: never publish it (it is already in .gitignore).

# Bot token from @BotFather
BOT_TOKEN=

# Interface language: en (default) or it
BOT_LANG=en

# ID of the admin group, where appeals are posted (e.g. -1001234567890).
# If empty the bot starts in "setup mode" and only answers /chatid@BotName
ADMIN_CHAT_ID=

# ID of the main group, where users were banned from.
# Required only with AUTO_UNBAN=true
MAIN_CHAT_ID=

# true = on approval the bot removes the ban in the main group
# (the bot must be an admin there with the "Ban users" permission)
AUTO_UNBAN=false

# Main group link sent to the user when the appeal is approved (optional)
# e.g. https://t.me/groupname or a private invite link
INVITE_LINK=

# true  = only admins/owner of the admin group can approve/deny/block
# false = any member of the admin group
REQUIRE_CHAT_ADMIN=false

# SQLite database path. Relative paths are resolved from the working directory:
# with the provided systemd unit it ends up in /var/lib/telegram-appeal-bot/
DB_PATH=appeals.db
